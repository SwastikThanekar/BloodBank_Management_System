# Frontend Environment Variables
# Copy this file to .env and update with your values

# Backend API URL
# For Vercel services deployment: use '/api' (relative path)
# For local development (localhost): use 'http://localhost:5000/api'
# For local development (network): use 'http://YOUR_IP:5000/api' (e.g., http://192.168.1.100:5000/api)
# For separate frontend/backend deployment: use full backend URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
