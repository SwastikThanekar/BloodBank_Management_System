# Backend Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret - Use a strong, random secret in production
JWT_SECRET=bloodbank-secret-key-change-in-production

# Database (SQLite file path - defaults to ./bloodbank.db)
DATABASE_PATH=./bloodbank.db

# For production, consider using PostgreSQL and set DATABASE_URL instead
# DATABASE_URL=postgresql://user:password@host:port/database
